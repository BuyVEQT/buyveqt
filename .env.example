# Alpha Vantage API key (free tier: 25 requests/day, 5/minute)
# Get yours at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_api_key_here

# Buttondown newsletter API key (optional — signup form works without it)
# Get yours at https://buttondown.com
BUTTONDOWN_API_KEY=your_api_key_here

# ── Reddit community feed (/community) ───────────────────────────────────
# Reddit 403s its .json API from ALL datacenter IPs (Vercel + Cloudflare), so
# scores/comments/subscribers need a request from a NON-datacenter IP. Set a
# residential-proxy template; {url} is replaced with the encoded Reddit URL.
# Examples (free tiers exist; with the 5-min caching, origin hits are tiny):
#   https://api.scraperapi.com/?api_key=KEY&url={url}
#   https://app.scrapingbee.com/api/v1/?api_key=KEY&render=false&url={url}
# Without this, the feed falls back to RSS (posts only, no scores/comments).
REDDIT_PROXY_TEMPLATE=

# Optional: app-only OAuth (oauth.reddit.com) also bypasses the IP block and
# lights up automatically if set. Requires a Reddit "script" app — currently
# gated behind a manual approval, so the proxy above is the primary route.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
